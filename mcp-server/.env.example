# Mandrel MCP Server Environment Configuration
# =============================================
# Copy this file to .env: cp .env.example .env
# These defaults work with docker-compose out of the box!

# ===========================================
# DATABASE (matches docker-compose defaults)
# ===========================================
DATABASE_USER=mandrel
DATABASE_HOST=localhost
DATABASE_NAME=mandrel
DATABASE_PASSWORD=mandrel_dev_password
DATABASE_PORT=5432

# Redis (for BullMQ job queues)
REDIS_URL=redis://localhost:6379

# ===========================================
# REQUIRED-BY-DESIGN: NODE_ENV
# ===========================================
# This header used to read "OPTIONAL VARIABLES (HAVE DEFAULTS)" while every key
# under it was boot-REQUIRED — dotenv-safe (src/config/database.ts) makes EVERY
# uncommented key here mandatory, and a missing one is process.exit(1) with no
# log line under NODE_ENV=production. "Optional" and "uncommented" are opposites
# in this file. Only keys whose code default would be WRONG or UNSAFE if it
# silently applied in prod stay uncommented.
#
# NODE_ENV stays: absent it resolves to 'development' (database.ts:23), which
# turns dotenv-safe's own failure into a warning, and selects the development
# posture across the process. A silent dev posture in prod is the unsafe default.
NODE_ENV=development

# ===========================================
# DE-REQUIRED 2026-08-26 — COMMENTED ON PURPOSE
# ===========================================
# Both had a perfectly good code default and neither could be wrong-in-prod, so
# both were pure over-declaration: absent, they took the container down; present,
# they changed nothing. Still DOCUMENTED here — commenting removes the boot
# requirement, not the documentation. Both remain declared on the ROOT
# .env.example surface, so the clean gate's env-coverage net still covers them
# (measured: `grep -E '^(LOG_LEVEL|DB_LOG_LEVEL)=' .env.example` -> 2 hits).
#
# LOG_LEVEL     — read at src/utils/logger.ts:193, defaults to 'info'.
# DB_LOG_LEVEL  — read by NOTHING in this package. Measured 2026-08-26:
#                 `grep -rn DB_LOG_LEVEL mcp-server --exclude-dir=node_modules
#                  --exclude-dir=dist` returned exactly ONE hit, this file's own
#                 declaration. It controlled nothing and could kill the boot.
# LOG_LEVEL=info
# DB_LOG_LEVEL=warn

# ===========================================
# DEVELOPMENT-ONLY VARIABLES
# ===========================================

# Development Database Override (optional)
# DATABASE_NAME=aidis_development

# ===========================================
# FUTURE/OPTIONAL FEATURES
# ===========================================

# Vector Embedding Configuration (not currently used)
# EMBEDDING_MODEL=text-embedding-ada-002
# EMBEDDING_DIMENSIONS=1536

# External API Keys (when needed)
# OPENAI_API_KEY=your_openai_api_key_here

# Caching (when implemented)
# REDIS_URL=redis://localhost:6379

# MCP Server Port Configuration (when implemented)
# MCP_SERVER_PORT=3000
# MCP_SERVER_HOST=localhost

# External Services (when needed)
# SENTRY_DSN=https://your-sentry-dsn

# ===========================================
# OAUTH FIRST-USER SEEDING
# ===========================================
# Read at EXEC TIME by src/scripts/seed-first-oauth-user.ts (the CLI an operator runs
# INSIDE the container via `docker exec -e`).
# They are NEVER part of the long-running mcp-server process env — they exist only for the
# duration of the seeding exec. Declared here (COMMENTED) so this file DOCUMENTS the product
# surface without dotenv-safe (config/database.ts) making them boot-required for every
# container (an uncommented key here becomes a required var → the whole fleet would fail
# validation).
# MANDREL_OAUTH_SEED_EMAIL=customer@example.com     # the login email to provision (required)
# MANDREL_OAUTH_SEED_NAME=Customer Name             # display name (defaults to the email)
# MANDREL_OAUTH_SEED_PASSWORD=generated-secret       # the login password (required; never logged)
# MANDREL_OAUTH_SEED_ROTATE=false                    # true = overwrite an existing credential (only overwrite path)

# ===========================================
# ATOMIC TASK CLAIM
# ===========================================
# Read at MODULE LOAD by src/config/claimConfig.ts. Declared here (COMMENTED) for the
# same reason as the OAuth block above: dotenv-safe (config/database.ts) treats every
# UNCOMMENTED key in this file as boot-REQUIRED, and a missing one is fatal under
# NODE_ENV=production (`process.exit(1)`). Measured 2026-07-25 — prod's systemd env
# file /etc/app/prod/mcp.env carries none of these, so uncommenting any line here
# would take prod Mandrel down on its next restart. The ENFORCED fleet-wide default
# lives in the tracked base docker-compose.yml (services.mcp-server.environment), which
# is where MANDREL_TASK_CLAIM_ENABLED is actually declared.
#
# MANDREL_AGENT_ACTORS=                             # comma list of caller actors that are AGENTS.
#                                                   # A listed actor's task_create is REFUSED [TASK_CREATE_AGENT_FOLD_IN]
#                                                   # unless tagged needs-operator. DEFAULT EMPTY = nobody matches; prod sets
#                                                   # builder,reviewer,auditor,ops-bot,researcher. config/agentActorsConfig.ts
# MANDREL_TASK_CLAIM_ENABLED=false                  # THE KILL SWITCH. false = claim tools dark,
#                                                   # task_update keeps legacy last-write-wins (no fence).
# MANDREL_TASK_CLAIM_DEFAULT_LEASE_SECONDS=2700     # lease granted when a claim omits one (45 min)
# MANDREL_TASK_CLAIM_MIN_LEASE_SECONDS=60           # floor on a requested lease
# MANDREL_TASK_CLAIM_MAX_LEASE_SECONDS=86400        # ceiling on a requested lease (24 h)
# MANDREL_TASK_CLAIM_ALLOWED_STATUSES=todo          # statuses a task may be claimed FROM (comma-separated)
# MANDREL_TASK_CLAIM_REENTRY_STATUSES=in_progress   # statuses the SAME holder may re-enter (comma-separated)
# Write-path reports carry a position-age notice once opened_at is older than this (hours; visibility only, no auto-close)
# MANDREL_POSITION_AGE_NOTICE_HOURS=24
# MANDREL_TASK_CLAIM_CLEARING_STATUSES=completed,cancelled  # statuses that release the claim (comma-separated)
# MANDREL_TASK_CLAIM_EVENT_RETENTION_DAYS=90        # task_claim_events retention (TaskClaimService.pruneEvents)

# --- Smart search: absent-term veto tolerance. All optional; defaults shown.
# Reference: docs/reference/configuration.md ("Recall & search").
# MANDREL_SEARCH_ABSENT_TERM_VETO=true                # empty result when a query names a thing no record has
# MANDREL_SEARCH_ABSENT_TERM_ORDINALS_ORDINARY=true   # 7th / 22nd never veto
# MANDREL_SEARCH_ABSENT_TERM_TOLERATED_ABSENT=1       # unknown names a long question may carry and still return rows
# MANDREL_SEARCH_ABSENT_TERM_TOLERATED_MIN_MATCHED=3  # matched terms needed before that tolerance applies
# MANDREL_SEARCH_NEAR_MISS_MIN_LENGTH=5               # shortest word that can be a typo of a corpus word
# MANDREL_SEARCH_NEAR_MISS_LONG_LENGTH=9              # length where the larger edit allowance starts
# MANDREL_SEARCH_NEAR_MISS_SHORT_DISTANCE=1
# MANDREL_SEARCH_NEAR_MISS_LONG_DISTANCE=2
# MANDREL_SEARCH_NEAR_MISS_PROJECT_FALLBACK=true      # whole-project typo check, only on the would-empty path
