  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:openapi": "npm --prefix ../backend run openapi:export && npx openapi-typescript-codegen --input ./.openapi/openapi.json --output src/api/generated --client fetch --useOptions --useUnionTypes",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "tokens:css": "node scripts/generate-tokens-css.ts"
  }
