# Mandrel Command Frontend — Environment Variables (Vite)
# Copy this file to `env/.env` (or `env/.env.local`) and configure as needed.
#
# ⚠ THIS `env/` DIRECTORY IS THE ONLY PLACE VITE LOADS ENV FILES FROM
# (vite.config.ts pins `envDir` here). A `.env*` file at the
# frontend root is IGNORED by every build and dev run. That pin is what keeps a
# forgotten root-level `.env.production.local` out of the shipped bundle on the
# on-host deploy paths, so do not "fix" it back to the root.
#
# Vite only exposes vars prefixed `VITE_` to the client bundle (this replaced the
# old CRA `REACT_APP_` prefix in the P0.1 Vite migration — see DEPLOY-NOTES.md).
# The `DEV_*` vars below are NOT `VITE_`-prefixed on purpose: they are read by
# vite.config.ts in Node (dev server / proxy tooling) and never reach the client.

# --- Client-exposed (VITE_) ---------------------------------------------------

# Backend REST API URL (command backend). Leave unset for same-origin `/api`
# (the golden-image default; nginx routes /api to the backend). Set to an
# absolute http(s) URL only for a split-origin dev setup.
# VITE_API_URL=http://localhost:5000/api

# MCP Server HTTP Bridge URL. Leave unset for same-origin.
# VITE_MCP_URL=http://localhost:8080

# WebSocket URL for real-time updates.
# VITE_WS_URL=ws://localhost:5000/ws

# Sentry Error Tracking (Optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false

# --- Dev-tooling only (NOT client-exposed; read in vite.config.ts) ------------

# Dev server port (default 3000).
# DEV_SERVER_PORT=3000

# `vite preview` port (default 4173).
# PREVIEW_SERVER_PORT=4173

# Target the dev server proxies `/api` to (default http://localhost:5000 — the
# command backend, matching the old CRA `"proxy"` field).
# DEV_API_PROXY_TARGET=http://localhost:5000
