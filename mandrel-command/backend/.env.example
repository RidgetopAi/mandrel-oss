# Mandrel Command Backend Environment Configuration
# =================================================
# Copy this file to .env: cp .env.example .env
# These defaults work with docker-compose out of the box!

# ===========================================
# DATABASE (matches docker-compose defaults)
# ===========================================
DATABASE_USER=mandrel
DATABASE_HOST=localhost
DATABASE_NAME=mandrel
DATABASE_PASSWORD=mandrel_dev_password
DATABASE_PORT=5432

# ===========================================
# AUTHENTICATION
# ===========================================
# IMPORTANT: Change MANDREL_JWT_SECRET in production!
# This is the single canonical JWT key — it is what AuthService signs with
# (services/auth.ts) AND what config validation requires. Do not reintroduce a
# separate JWT_SECRET; the legacy name is only read as a transitional fallback.
MANDREL_JWT_SECRET=mandrel-dev-secret-change-in-production-minimum-32-chars

# DE-REQUIRED 2026-08-26. Both have benign code defaults that are
# already the production values, so requiring them bought nothing and could kill
# the boot. See the DE-REQUIRED block at the end of this file for the full rule.
#   JWT_EXPIRES_IN — src/config/environment.ts:129, defaults to '24h'
#   BCRYPT_ROUNDS  — src/config/environment.ts:130, defaults to 12
# JWT_EXPIRES_IN=24h
# BCRYPT_ROUNDS=12

# INBOUND MACHINE CREDENTIAL for headless agents.
# The only route that accepts it is POST /api/git/push-stats, which the local
# mandrel-watcher daemon calls. Before 2026-08-25 that route took NO credential at all —
# anyone on the internet could write git statistics into an instance.
#
# UNSET is SAFE, not open: with no value the agent path is simply unavailable and the
# route falls back to ordinary user-JWT authentication, which 401s an anonymous caller.
# ⚠️ But the watcher's pushes WILL start returning 401 until it is given the same value.
# Generate a long random string; never commit a real one.
MANDREL_AGENT_TOKEN=

# ===========================================
# REQUIRED-BY-DESIGN: NODE_ENV
# ===========================================
# This header used to read "OPTIONAL VARIABLES (HAVE DEFAULTS)" while every key
# under it was boot-REQUIRED. dotenv-safe (src/config/environment.ts:41) makes
# EVERY uncommented key in this file mandatory, and a missing one is
# process.exit(1) with no log line under NODE_ENV=production. "Optional" and
# "uncommented" are opposites in this file.
#
# NODE_ENV stays: absent it resolves to 'development' (environment.ts:94), which
# downgrades dotenv-safe's own failure to a warning, enables console logging, and
# makes errorHandler expose stack traces. A silent dev posture in prod is unsafe.
NODE_ENV=development

# DE-REQUIRED 2026-08-26 — defaults are already the prod values:
#   MANDREL_HTTP_PORT — environment.ts:93, defaults to 5000
#   MANDREL_MCP_PORT  — services/mcpProxy.ts:70 et al, defaults to 8080
#   CORS_ORIGIN       — environment.ts:161, defaults to the localhost pair. The
#                       default is STRICTER than any real deployment, so it can
#                       only close access, never open it, and a wrong origin list
#                       fails LOUDLY in the browser rather than silently.
# MANDREL_HTTP_PORT=5000
# MANDREL_MCP_PORT=8080
# CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Legacy: PORT (use MANDREL_* instead)
# PORT=5000

# Reverse-proxy trust (SECURITY-sensitive) — controls Express `trust proxy`.
# Default (unset) is 'loopback': safe for prod's single loopback nginx.
# Accepts: 'loopback' | an integer hop-count (1/2/3) | 'false' | IP/CIDR/CSV.
# Do NOT use 'true' — it trusts the whole X-Forwarded-For chain and lets a client
# forge their IP to bypass the rate limiter.
# Fleet tenant chain (host-nginx -> Traefik -> tenant-nginx -> backend): set the
# EXACT hop-count, e.g. TRUST_PROXY=3, and verify it — NOT 'true'.
# TRUST_PROXY=loopback

# Logging Configuration — ALL DE-REQUIRED 2026-08-26.
# Every one is a benign tuning value with a code default equal to the value
# written here, so requiring them could only ever kill a boot.
#   LOG_LEVEL           — environment.ts:168 / config/logger.ts:82, default 'info'
#   DB_LOG_LEVEL        — environment.ts:169 / config/logger.ts:131, default 'warn'
#   ENABLE_LOG_ROTATION — environment.ts:171, default 'true'
#   LOG_MAX_FILE_SIZE   — environment.ts:172, default '20m'
#   LOG_MAX_FILES       — environment.ts:173, default '30d'
# LOG_LEVEL=info
# DB_LOG_LEVEL=warn
# ENABLE_LOG_ROTATION=true
# LOG_MAX_FILE_SIZE=20m
# LOG_MAX_FILES=30d

# ===========================================
# FEATURE FLAGS — DE-REQUIRED 2026-08-26
# ===========================================
# These three are the sharpest case in the file: NO CODE READS ANY OF THEM.
# Measured 2026-08-26, repo-wide, excluding node_modules/.git/dist/build:
#   grep -rn FEATURE_FLAG_PHASE1_ . --exclude-dir=node_modules --exclude-dir=.git \
#     --exclude-dir=dist --exclude-dir=build
# Every hit is a DECLARATION (this file, the root .env.example,
# config/environments/.env.example, docker-compose.yml) or a guard table
# describing those declarations. Zero `process.env.FEATURE_FLAG_PHASE1_*` reads.
# Uncommented they controlled nothing and were boot-fatal if absent; commented
# they still control nothing and cannot kill anything.
# FEATURE_FLAG_PHASE1_FEATURE_FLAGS=false
# FEATURE_FLAG_PHASE1_CONTRACT_TESTS=false
# FEATURE_FLAG_PHASE1_REACT_ERROR_BOUNDARIES=false

# ===========================================
# DEVELOPMENT/STAGING VARIABLES
# ===========================================

# Frontend URL — DE-REQUIRED 2026-08-26.
# Read by no backend code (`grep -rn 'process.env.FRONTEND_URL'
# mandrel-command/backend/src` -> 0 hits). It is declared in docker-compose.yml, so it
# keeps its value everywhere it had one; it simply stops being able to abort a
# boot. Same class as the feature flags above: set, never read.
# FRONTEND_URL=http://localhost:3000

# ===========================================
# EXTERNAL SERVICES (OPTIONAL)
# ===========================================

# Monitoring & Analytics (when implemented)
# SENTRY_DSN=https://your-sentry-dsn
# DATADOG_API_KEY=your-datadog-key

# External secrets management (when implemented)
# VAULT_URL=https://vault.example.com
# AWS_SSM_PARAMETER_PREFIX=/mandrel/