id	(?i)\b(?:task|decision|context|punch|milestone|spine|defect|tranche|epic|commit|audit|walkthrough|verdict|incident|finding|outage|refile)s?(?:[ \t]+|[ \t]*`)(?=[0-9a-f]{0,7}[0-9])[0-9a-f]{8}\b	fixed in task 1a2b3c4d
hexref	(?:^[ \t]*(?://|/\*|\*|#|--|<!--|[->][ \t]).*?|[(\[`]|\([^()'"`]*?[ \t]|\b(?:describe|it|test)\b[^(]*\([ \t]*['"`][^'"`]*?)(?<![0-9A-Za-z_#%\\])(?<![0-9A-Za-z_]\.)(?=[0-9a-f]{0,7}[0-9])(?=[0-9]{0,7}[a-f])[0-9a-f]{8}(?![0-9A-Za-z_-]|\.[0-9A-Za-z])|(?<=[a-z][ \t])(?<![0-9a-f]{8}[ \t])(?<![0-9A-Za-z_#%\\])(?<![0-9A-Za-z_]\.)(?=[0-9a-f]{0,7}[0-9])(?=[0-9]{0,7}[a-f])[0-9a-f]{8}(?![0-9A-Za-z_-]|\.[0-9A-Za-z])(?=[ \t]+(?:[a-z(-]|—|–)|[.,;:)!?][ \t]|[.,;:)!?]?$)|['"`](?<![0-9A-Za-z_#%\\])(?<![0-9A-Za-z_]\.)(?=[0-9a-f]{0,7}[0-9])(?=[0-9]{0,7}[a-f])[0-9a-f]{8}(?![0-9A-Za-z_-]|\.[0-9A-Za-z])[ \t]+[A-Za-z]	bisected to (9f8e7d6c)
lesson	(?i)\blessons?[ \t]+\d{3}\b	per Lesson 027
