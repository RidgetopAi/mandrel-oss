repo	(?i)\bra-(?:mandrel|runtime|omarchy|cockpit|site|daisy|builder)\b	see ra-mandrel main
host	(?i)hetzner|\bovh\b	ssh hetzner
ip	\b(?:100\.122|100\.74\.187|178\.156|135\.148)\.\d	curl http://100.122.0.1:8080
path	/opt/mandrel|/etc/mandrel|/etc/ridge|\.mandrel-bridge\.env|(?<![\w.~$}-])/root/	cd /opt/mandrel/app
service	(?i)telegram	page via Telegram
id	(?i)\b(?:task|decision|context|punch|milestone|spine)s?(?:[ \t]+|[ \t]*`)(?=[0-9a-f]{0,7}[0-9])[0-9a-f]{8}\b	fixed in task 1a2b3c4d
lesson	(?i)\blessons?[ \t]+\d{3}\b	per Lesson 027
