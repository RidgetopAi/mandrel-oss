# =============================================================================
# MANDREL UNIFIED ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env: cp .env.example .env
# This file documents ALL environment variables for all Mandrel components.
#
# Components:
#   - MCP Server (mcp-server/)
#   - Mandrel Command Backend (mandrel-command/backend/)
#   - Mandrel Command Frontend (mandrel-command/frontend/)
#
# Legend:
#   [REQUIRED] - Must be set for the application to function
#   [OPTIONAL] - Has a sensible default, can be overridden
#   [DEV-ONLY] - Only used in development environments
#   [PROD-ONLY] - Only used in production environments
#
# =============================================================================


# =============================================================================
# ENVIRONMENT
# =============================================================================
# [REQUIRED] Application environment - affects logging, security, and defaults

NODE_ENV=development
# Options: development, staging, production


# =============================================================================
# HOST PORTS (the container stack: install.sh / docker compose)
# =============================================================================
# The ports the stack publishes on THIS machine. Every one binds 127.0.0.1 only.
# install.sh checks they are free before it starts anything; if one is busy it
# prints the line to add here. Uncomment a line to move that port.
#
# MANDREL_MCP_HOST_PORT=8080            # MCP server (/mcp, /health). Moving it? also
#                                       # update the URL in your MCP client config, and
#                                       # MCP_ALLOWED_HOSTS must list localhost:<port> and
#                                       # 127.0.0.1:<port> (install.sh adds them).
# MANDREL_DASHBOARD_HOST_PORT=3000      # dashboard (open it in the browser)
# MANDREL_DASHBOARD_API_HOST_PORT=5000  # dashboard REST API (the dashboard reaches it
#                                       # inside the stack; nothing on the host needs it)
#
# PostgreSQL and Redis get NO fixed host port by default: the install path never
# reaches them from the host (scripts/validate-install.sh runs inside the
# containers), and a database or Redis you already run on 5432/6379 never blocks
# the install. Docker still gives each a random 127.0.0.1 port; `docker compose
# port postgres 5432` shows it. Anything run on the HOST that talks to them (the
# services run from source, npm run migrate, psql, redis-cli) needs a fixed port:
# set both, and point DATABASE_PORT / REDIS_URL / REDIS_PORT at the same numbers
# (CONTRIBUTING.md uses 55432 / 56379, away from any host install):
# MANDREL_POSTGRES_HOST_PORT=55432
# MANDREL_REDIS_HOST_PORT=56379
#
# Older names that still work (the names above win when both are set):
# TENANT_MCP_PORT, TENANT_FRONTEND_PORT, TENANT_BACKEND_PORT, TENANT_PG_PORT,
# TENANT_REDIS_PORT.
#
# The DATABASE_PORT / REDIS_* / MANDREL_MCP_PORT / MANDREL_HTTP_PORT keys further
# down are NOT host ports for the container stack: docker-compose.yml sets those
# inside the containers. They apply only to a native (host) run of the services.


# =============================================================================
# DATABASE (PostgreSQL with pgvector)
# =============================================================================
# [REQUIRED] Database connection settings
# Used by: MCP Server, Mandrel Command Backend
#
# Prerequisites:
#   - PostgreSQL 14+ with pgvector extension
#   - Extensions: vector, pg_trgm, pgcrypto, uuid-ossp
#
# Native (host) run only: the container stack sets every DATABASE_* value itself
# and ignores these. Update user/password for your local PostgreSQL installation.

DATABASE_HOST=localhost
# Database server hostname or IP address

DATABASE_PORT=5432
# PostgreSQL port a NATIVE run connects to (default: 5432). Not a container host
# port: see HOST PORTS above.

DATABASE_NAME=mandrel
# Database name (canonical name used across all environments)

DATABASE_USER=mandrel
# Database username

DATABASE_PASSWORD=mandrel_dev_password
# [REQUIRED] Database password
# IMPORTANT: Change this in production!

# [OPTIONAL] Full connection URL (alternative to individual settings above)
# DATABASE_URL=postgresql://mandrel:password@localhost:5432/mandrel
# Note: If set, this takes precedence over individual DATABASE_* variables


# =============================================================================
# REDIS (BullMQ Job Queues)
# =============================================================================
# [OPTIONAL] Redis connection for background job processing
# Used by: MCP Server (job queues)

REDIS_URL=redis://localhost:6379
# Full Redis connection URL


# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================
# Settings specific to the MCP (Model Context Protocol) server

MANDREL_MCP_PORT=8080
# [OPTIONAL] Port a NATIVE MCP server listens on (default: 8080). The container stack
# ignores it; its host port is MANDREL_MCP_HOST_PORT (HOST PORTS above).

# MANDREL_MCP_BRIDGE_PORT=8081
# [OPTIONAL] Port for MCP HTTP bridge (production only)

MCP_DEBUG=errors
# [OPTIONAL] MCP debug level
# Options: none, errors, all


# =============================================================================
# MANDREL COMMAND SERVER CONFIGURATION
# =============================================================================
# Settings specific to the Mandrel Command dashboard backend

MANDREL_HTTP_PORT=5000
# [OPTIONAL] Port a NATIVE dashboard backend listens on (default: 5000). The container
# stack ignores it; its host port is MANDREL_DASHBOARD_API_HOST_PORT (HOST PORTS above).

# MANDREL_COMMAND_PROD_PORT=5000
# [PROD-ONLY] Production port for Mandrel Command

CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# [OPTIONAL] Comma-separated list of allowed CORS origins
# IMPORTANT: In production, restrict to your actual domain(s)
# Example: CORS_ORIGIN=https://command.yourdomain.com

FRONTEND_URL=http://localhost:3000
# [DEV-ONLY] Frontend URL for development CORS configuration

BODY_LIMIT_AUTHENTICATED=10mb
# [OPTIONAL] Max request body parsed AFTER a credential is verified (default: 10mb)

BODY_LIMIT_PUBLIC=16kb
# [OPTIONAL] Max request body parsed on the few unauthenticated routes, e.g. login (default: 16kb)
# Keep this small: an anonymous caller must never make the server buffer megabytes.


# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
# [REQUIRED for Mandrel Command] JSON Web Token configuration
# Used by: Mandrel Command Backend

JWT_SECRET=mandrel-dev-secret-change-in-production-minimum-32-chars
# [REQUIRED] Secret key for signing JWTs
# CRITICAL: Change this in production! Minimum 32 characters recommended.

JWT_EXPIRES_IN=24h
# [OPTIONAL] Token expiration time (default: 24h)
# Formats: 60, "2 days", "10h", "7d"

BCRYPT_ROUNDS=12
# [OPTIONAL] bcrypt hashing rounds (default: 12)
# Higher = more secure but slower. Range: 10-14 recommended


# =============================================================================
# LOGGING
# =============================================================================
# [OPTIONAL] Logging configuration for all components

LOG_LEVEL=info
# Application log level
# Options: error, warn, info, debug, trace
# Recommended: info (development), warn (production)

DB_LOG_LEVEL=warn
# Database query log level
# Options: error, warn, info, debug
# Recommended: warn (development), error (production)

ENABLE_LOG_ROTATION=true
# [OPTIONAL] Enable log file rotation (default: true)

LOG_MAX_FILE_SIZE=20m
# [OPTIONAL] Maximum log file size before rotation
# Options: 10m, 20m, 50m, 100m

LOG_MAX_FILES=30d
# [OPTIONAL] How long to keep rotated log files
# Options: 7d, 14d, 30d, 60d


# =============================================================================
# FEATURE FLAGS
# =============================================================================
# [OPTIONAL] Toggle features on/off without code changes
# Used by: Mandrel Command Backend

FEATURE_FLAG_PHASE1_FEATURE_FLAGS=false
# Enable Phase 1 feature flags system

FEATURE_FLAG_PHASE1_CONTRACT_TESTS=false
# Enable Phase 1 contract testing

FEATURE_FLAG_PHASE1_REACT_ERROR_BOUNDARIES=false
# Enable React error boundaries (recommended: true in production)


# =============================================================================
# RATE LIMITING (Production)
# =============================================================================
# [PROD-ONLY] Protect against abuse

# RATE_LIMIT_WINDOW_MS=300000
# Rate limit window in milliseconds (default: 5 minutes)

# RATE_LIMIT_MAX_REQUESTS=50
# Maximum requests per window per IP

# MAX_FILE_SIZE=5242880
# Maximum upload file size in bytes (default: 5MB)

# UPLOAD_DIR=/var/mandrel/uploads
# Directory for uploaded files (production)


# =============================================================================
# EMBEDDING & AI CONFIGURATION (Future)
# =============================================================================
# [OPTIONAL] Vector embedding configuration (reserved for future use)

# EMBEDDING_MODEL=text-embedding-ada-002
# Embedding model to use (currently using local Transformers.js)

# EMBEDDING_DIMENSIONS=1536
# Vector dimensions (must match model output)

# OPENAI_API_KEY=your_openai_api_key_here
# OpenAI API key (if using OpenAI embeddings)


# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# [OPTIONAL] Third-party service integrations

# SENTRY_DSN=https://your-sentry-dsn
# Sentry error tracking DSN

# DATADOG_API_KEY=your-datadog-key
# Datadog monitoring API key

# VAULT_URL=https://vault.example.com
# HashiCorp Vault URL for secrets management

# AWS_SSM_PARAMETER_PREFIX=/mandrel/
# AWS SSM Parameter Store prefix


# =============================================================================
# NOTES
# =============================================================================
#
# Database Setup (Native, without Docker):
#   1. Install PostgreSQL 14+ with pgvector extension
#   2. Create database: createdb mandrel
#   3. Enable extensions:
#      psql -d mandrel -c "CREATE EXTENSION vector;"
#      psql -d mandrel -c "CREATE EXTENSION pg_trgm;"
#      psql -d mandrel -c "CREATE EXTENSION pgcrypto;"
#      psql -d mandrel -c "CREATE EXTENSION \"uuid-ossp\";"
#   4. Update DATABASE_USER and DATABASE_PASSWORD above
#
# Docker Setup:
#   - Default values work with docker-compose out of the box
#   - Just copy this file to .env and run: docker-compose up
#
# Production Checklist:
#   [ ] Change DATABASE_PASSWORD to a strong password
#   [ ] Change JWT_SECRET to a unique 32+ character string
#   [ ] Set CORS_ORIGIN to your actual domain(s)
#   [ ] Set NODE_ENV=production
#   [ ] Review LOG_LEVEL settings (recommend: warn or error)
#   [ ] Enable rate limiting variables
#   [ ] Configure external services (Sentry, etc.) as needed
#
# =============================================================================

# =============================================================================
# MODULE-LOAD TUNABLES — deny-by-default gate surface
# =============================================================================
# These are OPTIONAL tunables the product reads at MODULE LOAD (their code defaults,
# shown here, apply when unset). They carry NO product-namespace prefix, so the
# deploy-gate env contract could not see them via a prefix — declaring them on this
# tracked surface is what makes the gate's deny-by-default coverage true BY
# CONSTRUCTION (a coverage meta-test asserts every module-load config read is covered
# here or by a prefix, and fails the day a new one is born). Documenting them also satisfies configs-not-hardcoded.
#
# IMPORTANT: this ROOT .env.example is NOT a dotenv-safe manifest (only
# mcp-server/.env.example and mandrel-command/backend/.env.example are — adding an
# OPTIONAL tunable there would force every runtime .env to define it and crash prod
# on startup). Optional tunables belong HERE, on the surface, not in a manifest.

# --- mcp-server/src/config/searchConfig.ts ---
# Id-search ambiguity guard: max candidate rows considered before disambiguating.
SEARCH_ID_MAX_CANDIDATES=25
# Score boost applied to an exact id match (relative to the profile's max score).
SEARCH_ID_MATCH_SCORE_BOOST=1.0

# --- mcp-server/src/config/taskConfig.ts ---
# Max task ids accepted in one task_bulk_update call.
TASK_BULK_MAX_IDS=500
# Max dependencies allowed per task.
TASK_MAX_DEPENDENCIES=10
# Max `{ text, owner, proof? }` clauses punch.doneWhen may carry.
TASK_MAX_PUNCH_CLAUSES=20
# Max repo-relative paths/globs punch.touches may carry.
TASK_MAX_PUNCH_TOUCHES=50
# Trigram admission floor for the task source's word-overlap gate. Word overlap decides
# whether a task row is a CANDIDATE; it is not what ranks it (defect D1's lesson). On the
# embedder-down path it does become the ranking signal, because a degraded answer beats an
# empty one.
SEARCH_TASK_TRGM_ADMIT_FLOOR=0.1
# Default row limit for a direct task search when the caller names none.
SEARCH_TASK_DEFAULT_LIMIT=20

# --- mandrel-command/backend/src/config/analyticsTime.ts ---
# Default timezone for analytics time-bucket aggregation.
ANALYTICS_DEFAULT_TIMEZONE=UTC

# --- mandrel-command/backend/src/config/analyticsRange.ts ---
# Window used when a range-scoped analytics read sends no `days`.
ANALYTICS_DEFAULT_RANGE_DAYS=30
# Smallest accepted window — a zero/negative window is a caller bug, not "no data".
ANALYTICS_MIN_RANGE_DAYS=1
# Hard ceiling; a larger `?days=` is CLAMPED rather than scanning the whole table.
ANALYTICS_MAX_RANGE_DAYS=365

# --- mandrel-command/backend/src/config/logger.ts ---
# Log output directory (the container overrides to /app/logs, a mounted volume).
LOG_DIR=logs

# --- mandrel-command/backend/src/config/environment.ts ---
# Express 'trust proxy' setting: an integer hop-count, a boolean, or a named preset.
TRUST_PROXY=loopback
# Session productivity-score weights (per-unit contributions + caps).
SCORE_PER_CONTEXT=2.0
SCORE_PER_DECISION=3.0
SCORE_PER_TASK_COMPLETED=4.0
SCORE_PER_HOUR=1.5
SCORE_MAX_HOURS=8
SCORE_PER_1K_TOKENS=0.5
SCORE_MAX_1K_TOKENS=10

# --- module-load reads OUTSIDE config/ (widened-scope round; A') ---
# The accounting tripwire now scans all of mcp-server/src + mandrel-command/backend/src
# (not just config/), which surfaced these prefix-less reads in logger/queue/embedding/
# permalink/auth code. Declared here (defaults from source) so the surface net covers
# them. (11 found by the meta-test's ground-truth extraction — one more, ALLOW_DEV_
# AUTH_BYPASS, than the escalation's list; computing beats trusting a list.)
# mcp-server/src/config/commandUrlConfig.ts
# This instance's OWN Command UI origin, used for the /r/<id8> record permalinks emitted in
# tool results. NOT a shared constant — the value below is the PROD instance's. Every tenant
# must set its own (https://<tenant>.mandrel.example.com).
# Left unset, commandUrlConfig.ts derives it from this instance's own MCP_ALLOWED_HOSTS rather
# than defaulting to any one deployment, so a tenant can never inherit a foreign origin.
COMMAND_BASE_URL=http://localhost:3000
# mcp-server/src/utils/logger.ts
LOG_MAX_SIZE=10485760
LOG_CONSOLE=true
LOG_FILE=true
PERFORMANCE_LOGGING=false
REQUEST_LOGGING=true
CORRELATION_ID_HEADER=x-correlation-id
# mcp-server/src/services/queueManager.ts
REDIS_HOST=localhost
REDIS_PORT=6379
# API-key env vars (call-time credential reads via cfg.apiKeyEnvVar / embedder; OPTIONAL,
# documented here). All three are default apiKeyEnvVar values. This file is the template that
# ships: put real keys in your own .env (copied from it) and never commit .env.
# --- Supersession (optional) — OFF when no key is set ---------------------------------
# Adjudicates whether a new record supersedes an older one. Off unless a key is present.
# MANDREL_BELIEF_ENABLED=false                      # force off even with a key; =true with no key logs one DISARMED error
# The mode follows the keys you set when MANDREL_BELIEF_ADJUDICATOR_PROVIDER is unset:
#   SUBQ_API_KEY + ANTHROPIC_API_KEY -> tiered (tier 1 SubQ Snap, tier 2 Sonnet)
#   SUBQ_API_KEY only -> subq single-tier · ANTHROPIC_API_KEY only -> anthropic single-tier · neither -> off
# Recommended: set BOTH SUBQ_API_KEY (Snap, public preview - pricing may change) and ANTHROPIC_API_KEY.
# Hard daily spend cap on paid supersession calls (USD per UTC day, 0 = no cap); writes keep working when reached.
# MANDREL_BELIEF_DAILY_SPEND_CAP_USD=2
# MANDREL_BELIEF_ADJUDICATOR_PROVIDER=              # explicit: anthropic | openai-compat | ollama | subq | tiered (always wins over the keys)
# MANDREL_BELIEF_TIER1_PROVIDER=openai-compat       # tier 1 defaults to subq (Snap)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SUBQ_API_KEY=
# mandrel-command/backend/src/middleware/auth.ts  (dev-only bypass; MUST stay false/unset in prod)
ALLOW_DEV_AUTH_BYPASS=false

# --- helper-call tunables surfaced by the A' accounting (multi-line-aware extraction) ---
# The fail-closed accounting extracts helper-call literal
# first-args across the WHOLE product source, including multi-line calls — surfacing these
# prefix-less tunables that earlier (line-based) extraction missed. Defaults from source.
# mcp-server/src/config/searchConfig.ts
SEARCH_ID_PREFIX_MIN_LENGTH=6
# Max id-shaped TOKENS one query may contribute to the id OR-predicate.
# The old gate was per-QUERY ("does the whole query look like an id?"), so an id8 inside a
# sentence never matched; matching per-token removes that bound, and this replaces it so a
# pasted wall of text cannot grow the predicate without limit. Extra tokens are DROPPED,
# never merged — the query still runs.
SEARCH_ID_MAX_QUERY_TOKENS=4
# mandrel-command/backend/src/config/search.ts
SEARCH_DEFAULT_LIMIT=50
DECISION_SEARCH_MAX_LIMIT=100
TASK_LIST_DEFAULT_LIMIT=2000
TASK_LIST_MAX_LIMIT=2000
# mandrel-command/backend/src/config/sessionList.ts
# NOT the same knob as MANDREL_SESSION_LIST_* further down: those bound the mcp-server
# `session_list` TOOL (the identity read model an agent calls); these bound the Command UI's
# GET /api/sessions page. Different surfaces, different consumers, deliberately separate.
# The unprefixed name matches its siblings in this package (TASK_LIST_*, SEARCH_*).
# Sessions LIST page bounds (an earlier task §8). The list used to default to limit=1000
# inline while the UI pages far smaller; each returned row now carries four correlated
# count subqueries (counts are DERIVED from the child tables, never the denormalized
# sessions.*_created counters), so an unbounded default is a real cost. Prod has 457
# sessions total, so 200 covers the whole table without being "return everything".
SESSION_LIST_DEFAULT_LIMIT=200
SESSION_LIST_MAX_LIMIT=1000
# mandrel-command/backend/src/config/resolve.ts
RESOLVE_MAX_CANDIDATES=25
RESOLVE_SHORT_ID_MIN_LENGTH=8
RESOLVE_CONTEXT_SNIPPET_LENGTH=60
# mandrel-command/backend/src/config/daySummary.ts
DAY_SUMMARY_BASELINE_DAYS=7
DAY_SUMMARY_HEADLINE_MAXLEN=140
DAY_SUMMARY_MAX_SCORE=100
DAY_SUMMARY_NO_BASELINE_SUBSCORE=50
DAY_SUMMARY_ON_PAR_SUBSCORE=50
DAY_SUMMARY_W_DEPTH=0.3
DAY_SUMMARY_W_FOLLOWTHROUGH=0.3
DAY_SUMMARY_W_OUTPUT=0.4
MOMENTUM_SERIES_MAX_SPAN_DAYS=45

# mandrel-command/backend/src/config/environment.ts (health.ts /api/healthz memory check)
# Fraction of the V8 heap ceiling (heap_size_limit) above which /api/healthz reports memory "down".
HEALTHZ_HEAP_UTIL_THRESHOLD=0.9

# mcp-server/src/config/insightsConfig.ts (project_insights CODE-HEALTH scoring)
# Defaults are a mechanical extraction of the literals the pre-fix handler used — NOT a
# re-tuning. Scoring for a project WITH components is byte-identical to before the fix.
# Perfect-score ceiling a score starts from, and the floor it is clamped to: [FLOOR, CEILING].
INSIGHTS_HEALTH_SCORE_CEILING=100
INSIGHTS_HEALTH_SCORE_FLOOR=0
# Points deducted per unit of AVERAGE complexity (avg 2.0 -> -20 points).
INSIGHTS_HEALTH_AVG_COMPLEXITY_WEIGHT=10
# A single component above THRESHOLD incurs the flat PENALTY (and raises the issue).
INSIGHTS_HEALTH_MAX_COMPLEXITY_THRESHOLD=8
INSIGHTS_HEALTH_MAX_COMPLEXITY_PENALTY=20
# Average-complexity band boundaries: avg < HEALTHY -> 'healthy', < MODERATE -> 'moderate',
# else 'needs_attention'. Only consulted when the project HAS analyzed components — zero
# components short-circuits to 'no_data' (the point of an earlier change: absent != perfect).
INSIGHTS_HEALTH_LEVEL_HEALTHY_MAX=3
INSIGHTS_HEALTH_LEVEL_MODERATE_MAX=5
# Average complexity above which the "High average complexity" issue is raised.
INSIGHTS_HEALTH_HIGH_COMPLEXITY_ISSUE_THRESHOLD=5

# mcp-server/src/config/currentStateConfig.ts (recall_thread altitude:"current" — the
# deterministic CURRENT-STATE read model)
# These carry the MANDREL_ product prefix, so the deploy-gate env contract already covers
# them by prefix — they are declared here anyway because a tunable nobody can find is a
# hardcoded value with extra steps (configs-not-hardcoded), and because the .env.example
# surface is where this repo states "these are the knobs".
# Content depth of each node inside a current-state section: headline | summary | full.
# headline by default — the whole point of the altitude is ONE bounded response.
MANDREL_CURRENT_STATE_NODE_ALTITUDE=headline
# Trust floor a record must clear to be reported as a "latest TRUSTED outcome". A trust
# vocabulary name (trusted|ok|unproven|stale|superseded|contradicted) OR a 0-1 score.
MANDREL_CURRENT_STATE_TRUST_FLOOR=ok
# Minimum mapped outcome value (0-1, via trustModel's status mappers) for a record's own
# result to count as a landed outcome. 0.5 keeps successful/mixed, drops failed/cancelled.
MANDREL_CURRENT_STATE_OUTCOME_VALUE_FLOOR=0.5
# Arm the `awaiting-release` gate rung (true|false). true: finished work with no recorded
# artifact/release head is a real gate. Set false for a deployment that never records
# artifact references, so its finished threads read `complete` instead of parking forever.
MANDREL_CURRENT_STATE_RELEASE_GATE=true
# Per-section caps. A section that hits its cap reports exactly how many it dropped.
MANDREL_CURRENT_STATE_MAX_ACTIVE_TASKS=10
MANDREL_CURRENT_STATE_MAX_BLOCKERS=10
MANDREL_CURRENT_STATE_MAX_OUTCOMES=5
MANDREL_CURRENT_STATE_MAX_DECISIONS=10
MANDREL_CURRENT_STATE_MAX_RECENT_CONTEXTS=5
# Bounds the superseded-id SAMPLE only. The superseded COUNT is always exact and complete —
# that count is the honesty signal the read model turns on, and it is never capped.
MANDREL_CURRENT_STATE_MAX_SUPERSEDED_IDS=20
# Bounds the id SAMPLE echoed per HISTORICAL subtype (completed / abandoned / unknown).
# Same rule as the line above: the COUNTS are always exact, this only bounds
# how many ids are echoed for drill-down.
MANDREL_CURRENT_STATE_MAX_HISTORICAL_IDS=5
# mcp-server/src/config/coverageConfig.ts (GRAPH-AWARE project_insights — coverage over the
# typed-edge graph; Amp-orb eval Lane B P2)
# These replaced the count thresholds that told a healthy project to "document more
# decisions". NOTE what is NOT here: there is no knob that compares a record COUNT to a
# number, and there must never be one — every floor below is a RATIO of a measured
# population, guarded by a scale-invariance property test.
# Ratio floors (0-1). A dimension raises a finding only when its ratio falls BELOW its floor;
# an EMPTY population reports nothing at all (absent is never rendered as perfect).
# Active tasks carrying >=1 grounding edge (a link to a plan/decision/outcome).
MANDREL_INSIGHTS_GROUNDING_FLOOR=0.9
# Landed tasks backed by a SEPARATE trust-clearing outcome record (not self-report).
MANDREL_INSIGHTS_EVIDENCE_FLOOR=0.8
# Records carrying >=1 edge of any type — "does every branch converge".
MANDREL_INSIGHTS_CONVERGENCE_FLOOR=0.9
# Records carrying a session attribution (who wrote this).
MANDREL_INSIGHTS_ATTRIBUTION_FLOOR=0.9
# Historical records that clear the trust floor — the "unproven historical nodes" signal.
MANDREL_INSIGHTS_HISTORY_TRUST_FLOOR_RATIO=0.8
# The trust floor a record must clear to count as PROVEN. A trust vocabulary name
# (trusted|ok|unproven|stale|superseded|contradicted) OR a 0-1 score. Evaluated by the SAME
# clearsMinTrust() predicate `minTrust` and the current-state read model use.
MANDREL_INSIGHTS_TRUST_FLOOR=ok
# Max records hydrated + trust-annotated for one insights call. The answer always states its
# scope exactly (recordsInProject vs recordsExamined vs truncated), so a capped read is a
# STATED sample, never a silently partial answer.
MANDREL_INSIGHTS_MAX_NODES=300
# Bounds the per-finding drill-down id SAMPLE only. Finding counts are always exact.
MANDREL_INSIGHTS_MAX_SAMPLE_IDS=5
# Max findings printed in the HUMAN channel. structuredContent always carries them all.
MANDREL_INSIGHTS_MAX_RENDERED_FINDINGS=6

# mcp-server/src/config/reliableThreadingConfig.ts (reliable auto-threading: the durable/
# honest anchor + no-orphan inference). Declared here so every knob the
# module reads is on the repo's declared env surface (an earlier task's class).
# How long a persisted active-thread anchor stays valid; past it the anchor is treated as none.
MANDREL_ANCHOR_TTL_MS=86400000
# Min embedding cosine between a new capture and its anchor target to mint a trust-bearing edge.
MANDREL_ANCHOR_SIM_FLOOR=0.5
# Margin above that floor below which an ADMITTED anchor edge is flagged THIN MARGIN in the
# response. DISPLAY-ONLY — a thin edge is still minted; 0 disables the flag.
MANDREL_ANCHOR_THIN_MARGIN=0.05
# D2 project-scoped anchor fallback (default OFF — an anchorless connection must not inherit
# another session's anchor).
MANDREL_ANCHOR_PROJECT_FALLBACK_ENABLED=false
# Min cosine to the nearest non-orphan neighbor at which write-time inference mints related_to.
MANDREL_INFERENCE_THRESHOLD=0.6
# How many nearest neighbors write-time inference considers per store.
MANDREL_INFERENCE_CANDIDATE_LIMIT=1
# Master kill-switch for the A4 honesty gate + no-orphan inference layer.
MANDREL_RELIABLE_THREADING_ENABLED=true
# STRICT ANCHOR KEYING. ON = a connection with no resolved DB session gets
# NO anchor: thread_set/thread_current/thread_clear refuse with a typed error
# (ANCHOR_NO_SESSION_IDENTITY) and the context_store auto-thread read skips (surfaced),
# instead of falling back to the SHARED transport literal ('http-default'/'default-session')
# that every header-less caller reads and writes. OFF (default) = legacy shared-fallback
# behavior, byte-identical — the fleet ships dark; enable per tenant.
MANDREL_ANCHOR_STRICT_SESSION_KEYING=false

# mcp-server/src/config/sessionIdentityConfig.ts (the SESSION IDENTITY read model —
# session_status / session_list / session_get; Amp-orb eval finding W3).
# Declared here because a tunable nobody can find is a hardcoded value with extra steps
# (configs-not-hardcoded, an earlier task's class). The creation-reason VOCABULARY is
# deliberately NOT env-tunable — it is the contract the DB CHECK (migration 068) and the tool
# output both speak, and an operator must not be able to widen it from the environment.
# How many sessions session_list returns when the caller names no limit.
# (The Command UI's /api/sessions page uses the SEPARATE, unprefixed SESSION_LIST_* pair
# above — same idea, different surface. Changing one does not affect the other.)
MANDREL_SESSION_LIST_DEFAULT_LIMIT=20
# Hard ceiling on session_list's limit. A larger request is CLAMPED and the response says so.
MANDREL_SESSION_LIST_MAX_LIMIT=100
# mcp-server/src/config/projectBindingConfig.ts (PROJECT BINDING — an earlier task, Amp-orb
# eval finding W5). The CONFIGURED DEFAULT PROJECT for an AUTONOMOUS client: a project id
# OR name. When set, this process's clients START in that project and never auto-select
# one, and any call that explicitly names a DIFFERENT project fails with a typed error
# naming both. UNSET (the default) = no binding: project resolution is exactly as before
# and interactive project_switch is untouched. A per-connection client can instead declare
# it with the `X-Mandrel-Project` request header, which takes precedence over this env.
MANDREL_PROJECT_ID=

# mcp-server/src/config/actorProjectStateConfig.ts (ACTOR-KEYED CURRENT-PROJECT).
# ON = project_switch persists the caller's derived
# actor's current-project to the actor_project_defaults table (migration 073), and project
# resolution consults it: explicit projectId > X-Mandrel-Project binding > actor default >
# legacy connection slot. OFF (default) = today's connection-keyed behavior byte-identical;
# the table is never touched. Per-agent distinctness under ONE OAuth principal additionally
# needs MANDREL_ACTOR_COMPOSITE_ENABLED=true (otherwise N agents derive one actor).
MANDREL_ACTOR_PROJECT_STATE_ENABLED=false

# mcp-server/src/config/resilienceConfig.ts — absolute path to a bash file YOU supply that
# defines `notify TITLE BODY LEVEL EMOJI` (send it to chat, email, a pager — your choice).
# Mandrel sources it when an embedding failure or the provenance alarm needs a human.
# Empty = no alert is sent; the condition is logged only.
MANDREL_EMBED_ALERT_NOTIFY_SCRIPT=

# mcp-server/src/services/embedResilience.ts (notifyDeliveryCheck) — optional path to a
# credentials file your notify script reads (see MANDREL_EMBED_ALERT_NOTIFY_SCRIPT). When set,
# Mandrel checks it is readable before dispatching an alert. Empty = not checked.
MANDREL_NOTIFY_CREDS_ENV=

# mcp-server/src/config/attributionNoticeConfig.ts — where the unattributed-write notice
# points clients for setup instructions. Empty = the "Setup instructions" line is omitted.
MANDREL_ATTRIBUTION_NOTICE_SETUP_URL=

# =============================================================================
# TREEWALKER TIERS (Command backend — PHASE 2)
# =============================================================================
# [OPTIONAL] mandrel-command/backend/src/config/treewalkerConfig.ts — bounded-runtime caps
# for the derived-tier reads. Positive integers; bad/missing → the default.

# Max trunk-timeline entries the /api/treewalker/trunk endpoint returns (the count still
# reports the FULL total). Default 500.
MANDREL_TW_TRUNK_MAX_ENTRIES=500

# Max branches on the /api/treewalker/branches resume surface (newest-active first).
# Default 30.
MANDREL_TW_BRANCH_LIST_MAX=30

# NOTE: the Command backend now ALSO reads the MANDREL_TRUST_* knobs (documented in
# mcp-server/src/config/trustConfig.ts) through its mirrored canonical trust model
# (mandrel-command/backend/src/config/treewalkerTrustModel.ts) — same names, same
# defaults, parity-pinned by treewalkerTrustParity.test.ts. Tune them once for both.

# ── smart_search unified merge + ranking (mcp-server/src/config/searchMergeConfig.ts) ──
# The merge replaced per-source quotas with over-fetch + one global sort on a single
# comparable score. HARD RULE: every per-source weight DEFAULTS TO 1.0 — a constant
# handicap or bonus is the exact defect this merge deleted (a 0.6 floor on decisions
# outranked nearly every context by arithmetic). Do not reintroduce one under a new name.

# Candidates fetched per source = limit * this factor, before the global sort.
# Over-fetch is what reaches correctly-ranked rows that per-source truncation used to
# discard below the cut. Default 3.
SEARCH_MERGE_OVERFETCH_FACTOR=3

# smart_search time window (a YYYY-MM-DD in the query constrains results to that day;
# with a night word it spans (D-1) evening .. (D+1) noon). Times are read in this IANA zone.
# Invalid names fall back to UTC. Default UTC.
SEARCH_TIME_ZONE=UTC

# Comma-separated night words that widen a date to the night window (REPLACES the list).
# Default: last night,night of,overnight,night
SEARCH_NIGHT_WORDS=last night,night of,overnight,night

# Local hour (0-23) the night window opens on the day BEFORE the date. Default 18.
SEARCH_NIGHT_START_HOUR=18

# Local hour (0-23) the night window closes on the day AFTER the date. Default 12.
SEARCH_NIGHT_END_HOUR=12

# Candidates fetched per source = limit * this factor when a time window is active
# (the window filter discards rows after fetch). Default 5.
SEARCH_WINDOW_OVERFETCH_FACTOR=5

# Guaranteed minimum rows per source in the final result set. DEFAULT 0 = pure global
# sort, and 0 is the shipped behaviour on purpose: a guaranteed row per source IS a
# constant bonus wearing a structural disguise, and it evicts correctly-ranked rows to
# inject irrelevant ones. Opt in only for callers that explicitly want diversity.
SEARCH_MERGE_MIN_PER_SOURCE=0

# Per-source multipliers on the unified score. All 1.0 = sources compete on merit.
# They stay at 1.0 by rule: a per-source constant is defect D1 (a base score that
# outranks real signal) wearing a different name.
SEARCH_MERGE_WEIGHT_CONTEXT=1.0
SEARCH_MERGE_WEIGHT_DECISION=1.0
SEARCH_MERGE_WEIGHT_TASK=1.0

# Whether smart_search honours context_search's recency-query profile. DEFAULT false.
# That profile is triggered by a SUBSTRING match (so 'current' fires inside 'concurrent',
# 'last' inside 'blast radius', 'new' inside 'renewal') and applies a hard 60-day filter
# that makes older records unreachable rather than merely lower-ranked — measured: one
# question's home record moves from rank 21 to 1870 when the word 'recently' is added.
# Recall of history is the product, so smart_search pins the balanced profile.
# context_search is unaffected by this flag.
SEARCH_MERGE_APPLY_RECENCY_PROFILE=false

# Decision impact -> the unified score's IMPORTANCE term. These are a real per-record
# signal, not a per-source handicap; the source multipliers above stay at 1.0.
SEARCH_MERGE_IMP_DECISION_CRITICAL=1.0
SEARCH_MERGE_IMP_DECISION_HIGH=0.75
SEARCH_MERGE_IMP_DECISION_MEDIUM=0.5
SEARCH_MERGE_IMP_DECISION_LOW=0.25
SEARCH_MERGE_IMP_DECISION_DEFAULT=0.5

# Decision contribution to the TYPE-WEIGHT term of the unified score.
SEARCH_MERGE_TYPEWEIGHT_DECISION=0.9

# Task IMPORTANCE, in [0,1]. 0.5 is the neutral middle every source lands on for an
# unremarkable row (a context with an unset relevance_score, a decision with no
# impact_level), so this term hands tasks no standing edge or deficit. This is the term
# the status->weight map below multiplies.
SEARCH_MERGE_IMP_TASK_DEFAULT=0.5

# Task STATUS -> importance MULTIPLIER, one per tasks.status value. The
# task's importance is clamp01(SEARCH_MERGE_IMP_TASK_DEFAULT * weight). ALL DEFAULT TO 1.0
# so the map is the identity until an operator tunes it — a non-1.0 default would be a
# constant handicap/bonus by another name. Largest possible swing on the final score is
# 0.10 (the importance weight), a tiebreaker between near-equal cosines and never more.
# Read per call, so a change takes effect on the next search without a restart.
SEARCH_MERGE_IMP_TASK_STATUS_TODO=1.0
SEARCH_MERGE_IMP_TASK_STATUS_IN_PROGRESS=1.0
SEARCH_MERGE_IMP_TASK_STATUS_BLOCKED=1.0
SEARCH_MERGE_IMP_TASK_STATUS_COMPLETED=1.0
SEARCH_MERGE_IMP_TASK_STATUS_CANCELLED=1.0

# Task contribution to the TYPE-WEIGHT term. CALIBRATION, NOT A DERIVATION: `task` is not
# a context_type, so unlike the decision's 0.9 there was nothing in the type table to
# inherit. 0.5 is the midpoint of that table's populated range (0.4 ELSE .. 1.0 milestone)
# and sits above its "kind I have no opinion about" floor. The arithmetic it implies:
# against a decision a task runs (0.9-0.5)*0.10 = 0.04 of final score behind on this term,
# ~5.3 cosine points at the shipped similarity weight. NOT MEASURED against retrieval
# quality — override here rather than editing code if a sweep disagrees.
SEARCH_MERGE_TYPEWEIGHT_TASK=0.5

# --- mandrel-command/backend/src/config/openapi/spec-source.config.ts ---
# The OpenAPI spec the containers serve is a BUILD ARTIFACT, not a runtime glob. Before
# an earlier change it was generated at module load by swagger-jsdoc against './src/routes/*.ts',
# resolved from process.cwd() — and the runner image ships dist/ with no src/, so the glob
# matched nothing and every container served a well-formed document with paths:{} at HTTP
# 200. Measured empty on 7 of 7 containers. These two knobs are what make that state
# unreachable rather than merely fixed, so they are declared here even though both carry
# in-code defaults: the emitter reads them at BUILD time and the loader at BOOT time.

# Filename of the emitted spec artifact inside dist/. Deliberately NOT `openapi.json` —
# that name belongs to the checked-in frontend derivation guarded by the drift stage, and
# two files sharing a basename is how a guard ends up validating the wrong subject.
OPENAPI_ARTIFACT_BASENAME=openapi.spec.json

# Minimum documented paths for a spec to count as valid. ZERO IS NOT A VALID POPULATION:
# the whole defect was a zero-path document served as though it were the contract, so this
# floor is what turns a vacuous success into a finding — the emitter fails the build below
# it, and the loader refuses to serve the spec (503) rather than answer 200 with nothing.
# The spec carried 60 paths at v0.52.1; the floor sits far above zero so a collapsed glob
# cannot pass, and well below 60 so ordinary API churn never trips it. Keep this EQUAL to
# OPENAPI_DRIFT_MIN_PATHS in scripts/lib/openapi-drift.config.sh — the two guards measure
# different populations (source tree vs shipped image) and must not disagree on "too few".
OPENAPI_MIN_PATHS=20

# =============================================================================
# DOCKER COMPOSE (docker compose up -d --build)
# =============================================================================
# [REQUIRED] Password for the bundled Postgres; compose refuses to start while it
# is empty. Pick a strong unique value, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=

# [OPTIONAL] Bearer token the MCP server requires from clients. Leave empty to
# run without one (local use only); set a long random value otherwise.
MCP_AUTH_TOKEN=

# [OPTIONAL] Embedding model. minilm runs locally in-process, no key or service.
MANDREL_EMBEDDER=minilm

# [OPTIONAL] Tag for the locally built images (mandrel/<service>:<tag>). Default: local.
# Compose builds them from the Dockerfiles in this repo; "local" is the tag a fresh
# install builds and runs, and what docker-compose.yml uses when this is unset.
MANDREL_IMAGE_TAG=local

# [OPTIONAL] The Postgres+pgvector image. Unset = the exact version docker-compose.yml pins.
# PGVECTOR_IMAGE=ankane/pgvector:v0.5.1

# [OPTIONAL] Which tool surface the MCP server advertises on tools/list: "gateway" (the
# small discover + gateway tool set the README describes) or "legacy" (every flat tool).
MANDREL_TOOL_SURFACE=gateway

# [OPTIONAL] Dashboard admin login created by install.sh on first run. install.sh generates
# DASHBOARD_ADMIN_PASSWORD into .env and never regenerates it; set it yourself before the
# first run to choose your own.
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=

# [OPTIONAL] Actor name the printed MCP client config sends as X-Actor-ID, so what you store
# is attributed to you instead of "anonymous". Empty = the user who ran install.sh.
MANDREL_ACTOR_ID=

# ---- Per-container memory limits ----
# Every container in docker-compose.yml has a memory cap. Override any of these in a
# tenant/prod env file; the defaults below apply when unset (peaks measured 2026-10-17).
MCP_MEM_LIMIT=768m               # mcp-server
POSTGRES_MEM_LIMIT=1g            # postgres
COMMAND_BACKEND_MEM_LIMIT=384m   # mandrel-command-backend
REDIS_MEM_LIMIT=320m             # redis (its own maxmemory is 256mb)
COMMAND_FRONTEND_MEM_LIMIT=64m   # mandrel-command-frontend
# V8 old-space cap (MiB) for mcp-server, appended to NODE_OPTIONS; keep it below MCP_MEM_LIMIT.
MCP_MAX_OLD_SPACE_MB=512

# -----------------------------------------------------------------------------
# Dashboard first-admin bootstrap — read ONLY by the one-shot CLI
# mandrel-command/backend/src/scripts/createAdmin.ts (`node dist/scripts/createAdmin.js`),
# never by a running server. Empty = unset: ADMIN_USERNAME defaults to `admin`,
# ADMIN_EMAIL to `<username>@mandrel.local`; ADMIN_PASSWORD is required by the CLI.
# -----------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Test-runner marker. Set by vitest itself; mcp-server's embeddingsAllowMock()
# (src/config/embeddingConfig.ts) treats it as an explicit mock-embeddings opt-in.
# Leave it EMPTY on every real deployment.
# -----------------------------------------------------------------------------
VITEST=
